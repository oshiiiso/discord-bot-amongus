# ログレベル（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO
# ログ保持日数
LOG_RETENTION_DAYS=30

# アプリ名（ウィンドウタイトル・トレイなど）
# APP_NAME=AmongUs-Bot

# トレイアイコン（相対パスはプロジェクトルート基準）
# TRAY_ICON_PATH=assets/tray-icon.png

# ミュート操作の間隔（ミリ秒）
# MUTE_DELAY_MS=150

# 操作対象の人数更新間隔（ミリ秒）
# TARGET_REFRESH_MS=10000

# Bot切断時の再接続（ミリ秒）
# BOT_RECONNECT_INITIAL_MS=5000
# BOT_RECONNECT_MAX_MS=60000

# ポータブルモードを強制（通常は .portable ファイルで判定）
# PORTABLE=1

# 操作履歴の表示件数
# OPERATION_HISTORY_LIMIT=5

# ウィンドウ背景色
# WINDOW_BACKGROUND=#141517

# サポート・問い合わせ
# SUPPORT_EMAIL=support@example.com
# ISSUES_URL=https://github.com/your-org/your-repo/issues

# アップデート通知（パッケージ版のみ。いずれかを設定）
# GITHUB_OWNER=your-org
# GITHUB_REPO=discord-bot-amongus
# UPDATE_FEED_URL=https://example.com/updates

# 利用ガイドのカスタムパス（未設定時は docs/USER.md）
# USER_GUIDE_PATH=
