{
  "name": "amongus-bot",
  "version": "0.1.0",
  "description": "Among Us用 VCサーバーミュート操作",
  "main": "dist/main/index.js",
  "author": "oshiiiso",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "dev": "tsc && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win zip",
    "dist:dir": "npm run build && electron-builder --win dir --publish never"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "electron": "^37.3.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "com.amongus.bot",
    "productName": "AmongUs-Bot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "ui/**/*",
      "assets/**/*",
      "docs/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": ".portable",
        "to": ".portable"
      },
      {
        "from": ".env.dist",
        "to": ".env"
      }
    ],
    "publish": null,
    "win": {
      "target": [
        "zip"
      ]
    }
  }
}
